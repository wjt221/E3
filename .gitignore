# Dependencies
node_modules/
.pnp
.pnp.js

# Production build
.next/
out/
build/
dist/

# Environment variables — NEVER commit these
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# Secrets and credentials
*.pem
*.key
*.cert
*.p12
secrets/

# Client data — NEVER commit company data
data/
uploads/
documents/
*.pdf
*.docx
*.xlsx
*.csv
client-data/
company-data/

# Exception: E3 Compass Field Guides are internal E3 documentation (no client
# data; working examples are anonymized). Allow their generated PDFs only.
!docs/field-guides/*.pdf

# Logs — may contain client data
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

