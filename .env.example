# =============================================================================
# E3 AI Operating Partner — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file with real credentials.
# =============================================================================

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Anthropic (required) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Voyage AI for embeddings (optional, falls back to keyword search) ---
VOYAGE_API_KEY=pa-...

# --- App (required) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set to a long random string for production
NEXTAUTH_SECRET=change-this-in-production

# --- Feature flags ---
NEXT_PUBLIC_ENABLE_DOCUMENT_UPLOAD=true
NEXT_PUBLIC_ENABLE_RAG=true
